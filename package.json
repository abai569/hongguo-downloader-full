{
  "name": "hongguo-downloader",
  "version": "1.3.5",
  "description": "果抖下载器：红果短剧 + 抖音（短剧/合集/单条/主页/收藏）批量下载（Windows 桌面版）",
  "main": "main.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "dev:react": "vite",
    "build:react": "vite build",
    "build": "npm run build:react && electron-builder --win",
    "build:zip": "npm run build:react && electron-builder --win --dir && node scripts/make-zip.js",
    "build:dir": "npm run build:react && electron-builder --win --dir",
    "build:portable": "npm run build:react && electron-builder --win portable",
    "build:installer": "npm run build:react && electron-builder --win nsis",
    "pack": "electron-builder --dir",
    "zip": "node scripts/make-zip.js"
  },
  "dependencies": {
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.hongguo.downloader",
    "productName": "果抖下载器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist-react/**/*",
      "src/native/**/*",
      "src/store.js",
      "build/icon.png",
      "build/tray.png"
    ],
    "asar": true,
      "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "build/ffmpeg",
        "to": "bin",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe",
          "*.txt",
          "COPYING.*",
          "LICENSE.md"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "${name}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "果抖下载器",
      "artifactName": "${name}-setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
